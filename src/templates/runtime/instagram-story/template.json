{
  "id": "instagram-story",

  "name": "Instagram Story",

  "version": "1.0.0",

  "canvas": {

    "width": 1080,

    "height": 1920

  },

  "theme": {

    "background": "#FFFFFF",

    "text": "#000000",

    "accent": "#000000"

  },

  "fonts": {

    "default": "Inter"

  },

  "assets": {

    "logo": "assets/logo.svg",

    "background": "assets/background.png",

    "watermark": "assets/watermark.svg"

  },

  "elements": [

    {

      "id": "background",

      "type": "background",

      "frame": {

        "x": 0,

        "y": 0,

        "width": 1080,

        "height": 1920

      },

      "color": "#FFFFFF"

    },

    {

      "id": "logo",

      "type": "asset",

      "asset": "logo",

      "frame": {

        "x": 0,

        "y": 0,

        "width": 1080,

        "height": 120

      },

      "align": {

        "horizontal": "center",

        "vertical": "center"

      }

    },

    {

      "id": "productImage",

      "type": "image",

      "binding": "product.image",

      "frame": {

        "x": 0,

        "y": 120,

        "width": 1080,

        "height": 1080

      },

      "fit": "contain"

    },

    {

      "id": "productName",

      "type": "text",

      "binding": "product.name",

      "frame": {

        "x": 0,

        "y": 1200,

        "width": 1080,

        "height": 80

      },

      "style": {

        "fontSize": 48,

        "fontWeight": 700,

        "textAlign": "center",

        "verticalAlign": "middle"

      }

    },

    {

      "id": "productCategory",

      "type": "text",

      "binding": "product.category",

      "frame": {

        "x": 0,

        "y": 1290,

        "width": 1080,

        "height": 60

      },

      "style": {

        "fontSize": 36,

        "fontWeight": 400,

        "textAlign": "center",

        "verticalAlign": "middle"

      }

    },

    {

      "id": "productPrice",

      "type": "text",

      "binding": "product.price",

      "frame": {

        "x": 0,

        "y": 1365,

        "width": 1080,

        "height": 70

      },

      "style": {

        "fontSize": 36,

        "fontWeight": 400,

        "textAlign": "center",

        "verticalAlign": "middle"

      }

    }

  ]

}