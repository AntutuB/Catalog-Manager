{
  "id": "instagram-story",

  "name": "Instagram Story",

  "version": "2.0.0",

  "canvas": {
    "width": 1080,
    "height": 1920
  },

  "theme": {
    "background": "#FFFFFF",
    "text": "#000000",
    "accent": "#000000"
  },

  "fonts": {
    "default": "Inter"
  },

  "assets": {
    "logo": "logo"
  },

  "elements": [

    {
      "id": "background",

      "type": "background",

      "bounds": {
        "x": 0,
        "y": 0,
        "width": 1080,
        "height": 1920
      },

      "color": "#FFFFFF"
    },


    {
      "id": "logo",

      "type": "asset",

      "asset": "logo",

      "bounds": {
        "x": 0,
        "y": 242,
        "width": 1080,
        "height": 120
      },

      "layout": {
        "horizontal": "center",
        "vertical": "center"
      }
    },


    {
      "id": "productImage",

      "type": "image",

      "binding": "imageUrl",

      "bounds": {
        "x": 0,
        "y": 362,
        "width": 1080,
        "height": 1080
      },

      "layout": {
        "fit": "contain",
        "horizontal": "center",
        "vertical": "center"
      }
    },


    {
      "id": "productName",

      "type": "text",

      "binding": "name",

      "bounds": {
        "x": 0,
        "y": 1442,
        "width": 1080,
        "height": 80
      },

      "style": {
        "fontSize": 48,
        "fontWeight": 700,
        "textAlign": "center",
        "verticalAlign": "middle"
      },

      "layout": {
        "horizontal": "center",
        "vertical": "center"
      }
    },


    {
      "id": "productCategory",

      "type": "text",

      "binding": "type",

      "bounds": {
        "x": 0,
        "y": 1532,
        "width": 1080,
        "height": 60
      },

      "style": {
        "fontSize": 36,
        "fontWeight": 400,
        "textAlign": "center",
        "verticalAlign": "middle"
      },

      "layout": {
        "horizontal": "center",
        "vertical": "center"
      }
    },


    {
      "id": "productPrice",

      "type": "text",

      "binding": "price",

      "bounds": {
        "x": 0,
        "y": 1607,
        "width": 1080,
        "height": 70
      },

      "style": {
        "fontSize": 36,
        "fontWeight": 400,
        "textAlign": "center",
        "verticalAlign": "middle"
      },

      "layout": {
        "horizontal": "center",
        "vertical": "center"
      }
    }

  ]
}